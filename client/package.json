{
  "name": "@ootle/name-service",
  "version": "0.1.0",
  "description": "TypeScript client for the Ootle Name Service (ONS) registry: keyless name resolution via the indexer, plus daemon-signed writes.",
  "license": "BSD-3-Clause",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "demo": "tsx demo/resolve-okz.ts",
    "prepare": "tsc -p tsconfig.json"
  },
  "keywords": [
    "tari",
    "ootle",
    "name-service",
    "ons",
    "nostr",
    "registry"
  ],
  "peerDependencies": {
    "@tari-project/ootle": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@tari-project/ootle": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
